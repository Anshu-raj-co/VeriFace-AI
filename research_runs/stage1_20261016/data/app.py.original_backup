# Model Loading
# ---------------------------------------------------------------------------
@st.cache_resource(show_spinner=False)
def load_system():
    if not os.path.exists(MODEL_PATH):
        raise FileNotFoundError(f"Checkpoint not found at '{MODEL_PATH}'. Run train.py first.")

    checkpoint = torch.load(MODEL_PATH, map_location=DEVICE)
    if isinstance(checkpoint, dict) and "state_dict" in checkpoint:
        backbone = checkpoint.get("backbone", "efficientnet_b0")
        model_type = checkpoint.get("model_type", "vision")
        state_dict = checkpoint["state_dict"]
    else:
        backbone = "efficientnet_b0"
        model_type = "vision"
        state_dict = checkpoint

    model = build_model(model_type=model_type, backbone=backbone, pretrained=False)
    model.load_state_dict(state_dict)
    model.to(DEVICE)
    model.eval()
    return model, backbone, model_type

# ---------------------------------------------------------------------------
# Grad-CAM Tool
# ---------------------------------------------------------------------------
def find_last_conv_layer(module: nn.Module):
    last_conv = None
    for m in module.modules():
        if isinstance(m, nn.Conv2d):
            last_conv = m
    return last_conv

class GradCAM:
    def __init__(self, model: nn.Module):
        self.model = model
        target_layer = find_last_conv_layer(model.backbone)
        if target_layer is None:
            raise ValueError("Could not locate Conv2d layer in backbone.")
        self._activations = None
        self._gradients = None
        self._fwd_handle = target_layer.register_forward_hook(self._save_activation)
        self._bwd_handle = target_layer.register_full_backward_hook(self._save_gradient)

    def _save_activation(self, module, inp, out):
        self._activations = out.detach()

    def _save_gradient(self, module, grad_in, grad_out):
        self._gradients = grad_out[0].detach()

    def generate(self, input_tensor: torch.Tensor):
        self.model.zero_grad(set_to_none=True)
        with torch.enable_grad():
            logit = self.model(input_tensor)
            # Checkpoints are trained with FAKE = 1, so sigmoid(logit) = P(FAKE).
            # Grad-CAM therefore highlights evidence FOR "fake".
            prob_real = 1.0 - torch.sigmoid(logit).item()
            logit.backward()

        weights = self._gradients.mean(dim=(2, 3), keepdim=True)
        cam = torch.relu((weights * self._activations).sum(dim=1, keepdim=True))
        cam = cam.squeeze().cpu().numpy()

        cam -= cam.min()
        max_val = cam.max()
        if max_val > 1e-8:
            cam /= max_val
        return cam, prob_real

    def remove(self):
        self._fwd_handle.remove()
        self._bwd_handle.remove()

def overlay_heatmap(base_image: Image.Image, cam: np.ndarray, alpha: float = 0.45) -> Image.Image:
    import matplotlib

    cam_img = Image.fromarray((cam * 255).astype(np.uint8)).resize(base_image.size, resample=Image.BILINEAR)
    cam_arr = np.asarray(cam_img).astype(np.float32) / 255.0

    colormap = matplotlib.colormaps["jet"]
    heatmap_rgb = (colormap(cam_arr)[:, :, :3] * 255).astype(np.uint8)
    heatmap_img = Image.fromarray(heatmap_rgb).convert("RGB")

    base_rgb = base_image.convert("RGB")
    return Image.blend(base_rgb, heatmap_img, alpha=alpha)

